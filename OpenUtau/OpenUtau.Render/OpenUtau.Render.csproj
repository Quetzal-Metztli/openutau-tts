<Project Sdk="Microsoft.NET.Sdk">
  <!-- Colócalo como carpeta hermana de OpenUtau.Core dentro del repo clonado de OpenUtau. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
    <ProjectReference Include="..\OpenUtau.Plugin.Builtin\OpenUtau.Plugin.Builtin.csproj" />
  </ItemGroup>
  <!-- libworldline.so (el resampler nativo) debe quedar junto al ejecutable. Linux x64. -->
  <ItemGroup>
    <None Include="..\runtimes\linux-x64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
  </ItemGroup>
</Project>
